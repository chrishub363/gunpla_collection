<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Gunpla Collection" %></title>

    <%# Apply the saved theme (or OS preference) before first paint to avoid a flash. %>
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.classList.add(t);
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gunpla Collection">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-bg text-ink antialiased">

    <%# Top navigation bar %>
    <header class="sticky top-0 z-50 bg-panel border-b border-border px-6 py-3">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center gap-x-4 gap-y-3">

        <%# Logo / site name — always first %>
        <a href="<%= root_path %>" class="text-accent font-bold text-xl tracking-tight shrink-0 order-1">
          Gunpla Collection
        </a>

        <%# Theme toggle — leads the right-side cluster (ml-auto pushes the group right) %>
        <button type="button"
                data-controller="theme"
                data-action="click->theme#toggle"
                class="shrink-0 order-2 ml-auto md:ml-0 md:order-3 flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors text-muted hover:text-ink hover:bg-elevated cursor-pointer">
          <%# Shown in dark (Titans) — click to switch to light %>
          <svg class="theme-icon theme-icon-to-light w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
          </svg>
          <%# Shown in light (RX-78-2) — click to switch to dark %>
          <svg class="theme-icon theme-icon-to-dark w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
          </svg>
          <span class="sr-only">Toggle theme</span>
        </button>

        <%# Pick link — top-right on mobile (order 2), far-right on desktop (order 3) %>
        <%= link_to pick_path,
            class: "shrink-0 order-2 md:order-3 flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-colors text-muted hover:text-ink hover:bg-elevated" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="3" ry="3"/>
            <circle cx="8" cy="8" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="8" r="1.5" fill="currentColor"/>
            <circle cx="8" cy="16" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
          </svg>
          Pick
        <% end %>

        <%# Search bar — wraps to second line on mobile, stays inline on desktop (order 2) %>
        <%= form_with url: root_path, method: :get,
            class: "w-full order-3 md:order-2 md:flex-1 md:max-w-xl",
            data: { controller: "auto-submit" } do |f| %>
          <%= f.hidden_field :tab, value: params[:tab] || "collection" %>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <%= f.text_field :search,
                value: params[:search],
                placeholder: "Search kits...",
                data: { auto_submit_target: "searchInput", action: "input->auto-submit#toggleClear" },
                class: "w-full bg-elevated border border-border rounded-lg pl-9 pr-8 py-2 text-ink placeholder-muted focus:outline-none focus:border-accent transition-colors" %>
            <button type="button"
                    data-auto-submit-target="clearBtn"
                    data-action="click->auto-submit#clearAndSubmit"
                    class="absolute right-2 top-1/2 -translate-y-1/2 text-muted hover:text-ink transition-colors text-sm leading-none <%= params[:search].present? ? '' : 'hidden' %>">
              ✕
            </button>
          </div>
          <%= f.button "Search", class: "sr-only" %>
        <% end %>

      </div>
    </header>

    <%# Page content %>
    <main class="max-w-7xl mx-auto px-6 py-6">
      <%= yield %>
    </main>

  </body>
</html>
