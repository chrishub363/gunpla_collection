<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Gunpla Collection" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gunpla Collection">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-[#1a1625] text-[#f0e6ff] antialiased">

    <%# Top navigation bar %>
    <header class="sticky top-0 z-50 bg-[#1e1a2e] border-b border-[#2d2640] px-6 py-3">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center gap-x-4 gap-y-3">

        <%# Logo / site name — always first %>
        <a href="<%= root_path %>" class="text-[#e879a0] font-bold text-xl tracking-tight shrink-0 order-1">
          Gunpla Collection
        </a>

        <%# Pick link — top-right on mobile (order 2), far-right on desktop (order 3) %>
        <%= link_to pick_path,
            class: "shrink-0 order-2 ml-auto md:ml-0 md:order-3 flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-colors text-[#9d8faa] hover:text-[#f0e6ff] hover:bg-[#251f33]" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="3" ry="3"/>
            <circle cx="8" cy="8" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="8" r="1.5" fill="currentColor"/>
            <circle cx="8" cy="16" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
          </svg>
          Pick
        <% end %>

        <%# Search bar — wraps to second line on mobile, stays inline on desktop (order 2) %>
        <%= form_with url: root_path, method: :get,
            class: "w-full order-3 md:order-2 md:flex-1 md:max-w-xl",
            data: { controller: "auto-submit" } do |f| %>
          <%= f.hidden_field :tab, value: params[:tab] || "collection" %>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#9d8faa] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <%= f.text_field :search,
                value: params[:search],
                placeholder: "Search kits...",
                data: { auto_submit_target: "searchInput", action: "input->auto-submit#toggleClear input->auto-submit#submitWithDelay" },
                class: "w-full bg-[#251f33] border border-[#2d2640] rounded-lg pl-9 pr-8 py-2 text-[#f0e6ff] placeholder-[#9d8faa] focus:outline-none focus:border-[#e879a0] transition-colors" %>
            <button type="button"
                    data-auto-submit-target="clearBtn"
                    data-action="click->auto-submit#clearAndSubmit"
                    class="absolute right-2 top-1/2 -translate-y-1/2 text-[#9d8faa] hover:text-[#f0e6ff] transition-colors text-sm leading-none <%= params[:search].present? ? '' : 'hidden' %>">
              ✕
            </button>
          </div>
          <%= f.button "Search", class: "sr-only" %>
        <% end %>

      </div>
    </header>

    <%# Page content %>
    <main class="max-w-7xl mx-auto px-6 py-6">
      <%= yield %>
    </main>

  </body>
</html>
