<aside data-drawer-target="drawer"
       class="fixed top-0 right-0 h-full w-72 z-50 p-5 bg-[#1a1625] border-l border-[#2d2640] overflow-y-auto translate-x-full transition-transform duration-300 ease-in-out
              md:static md:translate-x-0 md:w-56 md:h-auto md:z-auto md:p-0 md:bg-transparent md:border-l-0 md:overflow-visible md:transition-none shrink-0">

  <%# Mobile-only header with close button %>
  <div class="flex items-center justify-between mb-6 md:hidden">
    <h2 class="text-sm font-semibold text-[#f0e6ff]">Filters</h2>
    <button type="button"
            data-action="click->drawer#close"
            class="text-[#9d8faa] hover:text-[#f0e6ff] transition-colors p-1 -mr-1">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
      <span class="sr-only">Close filters</span>
    </button>
  </div>

  <%# Client-side live filter — no form submission %>
  <div class="mb-6">
    <h3 class="text-xs font-semibold uppercase tracking-widest text-[#9d8faa] mb-3">Filter</h3>
    <div class="relative">
      <input type="text"
             placeholder="Filter visible kits..."
             data-filter-target="input"
             data-action="input->filter#filter"
             class="w-full bg-[#251f33] border border-[#2d2640] rounded-lg px-3 py-2 pr-8 text-sm text-[#f0e6ff] placeholder-[#9d8faa] focus:outline-none focus:border-[#e879a0] transition-colors">
      <button type="button"
              data-filter-target="clearBtn"
              data-action="click->filter#clear"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-[#9d8faa] hover:text-[#f0e6ff] transition-colors text-sm leading-none">
        ✕
      </button>
    </div>
  </div>

  <%= form_with url: root_path, method: :get, data: { controller: "auto-submit" } do |f| %>
    <%= f.hidden_field :tab, value: @tab %>

    <%# Status filter — collection only %>
    <% if @tab != "wishlist" %>
      <%= render layout: "filter_section", locals: { title: "Status" } do %>
        <%= f.radio_button :status, "", checked: params[:status].blank?, class: "hidden", id: "status_all",
            data: { action: "change->auto-submit#submit" } %>
        <%= label_tag "status_all", "All", class: sidebar_filter_label_class(params[:status].blank?) %>
        <% @statuses.each do |status| %>
          <%= f.radio_button :status, status, checked: params[:status] == status, class: "hidden", id: "status_#{status}",
              data: { action: "change->auto-submit#submit" } %>
          <%= label_tag "status_#{status}", status.humanize, class: sidebar_filter_label_class(params[:status] == status) %>
        <% end %>
      <% end %>
    <% end %>

    <%# Grade filter %>
    <% if @grades.any? %>
      <%= render layout: "filter_section", locals: { title: "Grade" } do %>
        <%= f.radio_button :grade, "", checked: params[:grade].blank?, class: "hidden", id: "grade_all",
            data: { action: "change->auto-submit#submit" } %>
        <%= label_tag "grade_all", "All", class: sidebar_filter_label_class(params[:grade].blank?) %>
        <% @grades.each do |grade| %>
          <%= f.radio_button :grade, grade, checked: params[:grade] == grade, class: "hidden", id: "grade_#{grade}",
              data: { action: "change->auto-submit#submit" } %>
          <%= label_tag "grade_#{grade}", grade, class: sidebar_filter_label_class(params[:grade] == grade) %>
        <% end %>
      <% end %>
    <% end %>

    <%# Scale filter %>
    <%= render layout: "filter_section", locals: { title: "Scale" } do %>
      <%= f.radio_button :scale, "", checked: params[:scale].blank?, class: "hidden", id: "scale_all",
          data: { action: "change->auto-submit#submit" } %>
      <%= label_tag "scale_all", "All", class: sidebar_filter_label_class(params[:scale].blank?) %>
      <% @scales.each do |scale| %>
        <% scale_id = "scale_#{scale.gsub(':', '_')}" %>
        <%= f.radio_button :scale, scale, checked: params[:scale] == scale, class: "hidden", id: scale_id,
            data: { action: "change->auto-submit#submit" } %>
        <%= label_tag scale_id, scale, class: sidebar_filter_label_class(params[:scale] == scale) %>
      <% end %>
    <% end %>

    <%# Brand filter %>
    <%= render layout: "filter_section", locals: { title: "Brand" } do %>
      <%= f.radio_button :brand, "", checked: params[:brand].blank?, class: "hidden", id: "brand_all",
          data: { action: "change->auto-submit#submit" } %>
      <%= label_tag "brand_all", "All", class: sidebar_filter_label_class(params[:brand].blank?) %>
      <% @brands.each do |brand| %>
        <% brand_id = "brand_#{brand.parameterize}" %>
        <%= f.radio_button :brand, brand, checked: params[:brand] == brand, class: "hidden", id: brand_id,
            data: { action: "change->auto-submit#submit" } %>
        <%= label_tag brand_id, brand, class: sidebar_filter_label_class(params[:brand] == brand) %>
      <% end %>
    <% end %>

  <% end %>
</aside>
