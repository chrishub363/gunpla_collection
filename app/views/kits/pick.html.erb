<div class="max-w-2xl mx-auto">

  <div class="mb-8">
    <h1 class="text-2xl font-bold text-ink mb-1">🎲 Pick a Kit</h1>
    <p class="text-sm text-muted">Narrow it down, then let fate decide.</p>
  </div>

  <%= form_with url: pick_path, method: :get do |f| %>
    <div class="bg-panel border border-border rounded-xl p-6 mb-4 space-y-5">

      <%# Grade %>
      <% if @grades.any? %>
        <div data-controller="pill-select" data-action="change->pill-select#refresh">
          <div class="text-xs font-semibold uppercase tracking-widest text-muted mb-2">Grade</div>
          <div class="flex flex-wrap gap-2">
            <%= f.radio_button :grade, "", checked: params[:grade].blank?, class: "hidden", id: "pick_grade_all" %>
            <%= label_tag "pick_grade_all", "All", class: pill_filter_label_class(params[:grade].blank?) %>
            <% @grades.each do |grade| %>
              <%= f.radio_button :grade, grade, checked: params[:grade] == grade, class: "hidden", id: "pick_grade_#{grade}" %>
              <%= label_tag "pick_grade_#{grade}", grade, class: pill_filter_label_class(params[:grade] == grade) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Scale %>
      <% if @scales.any? %>
        <div data-controller="pill-select" data-action="change->pill-select#refresh">
          <div class="text-xs font-semibold uppercase tracking-widest text-muted mb-2">Scale</div>
          <div class="flex flex-wrap gap-2">
            <%= f.radio_button :scale, "", checked: params[:scale].blank?, class: "hidden", id: "pick_scale_all" %>
            <%= label_tag "pick_scale_all", "All", class: pill_filter_label_class(params[:scale].blank?) %>
            <% @scales.each do |scale| %>
              <% scale_id = "pick_scale_#{scale.gsub(':', '_')}" %>
              <%= f.radio_button :scale, scale, checked: params[:scale] == scale, class: "hidden", id: scale_id %>
              <%= label_tag scale_id, scale, class: pill_filter_label_class(params[:scale] == scale) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Brand %>
      <% if @brands.any? %>
        <div data-controller="pill-select" data-action="change->pill-select#refresh">
          <div class="text-xs font-semibold uppercase tracking-widest text-muted mb-2">Brand</div>
          <div class="flex flex-wrap gap-2">
            <%= f.radio_button :brand, "", checked: params[:brand].blank?, class: "hidden", id: "pick_brand_all" %>
            <%= label_tag "pick_brand_all", "All", class: pill_filter_label_class(params[:brand].blank?) %>
            <% @brands.each do |brand| %>
              <% brand_id = "pick_brand_#{brand.parameterize}" %>
              <%= f.radio_button :brand, brand, checked: params[:brand] == brand, class: "hidden", id: brand_id %>
              <%= label_tag brand_id, brand, class: pill_filter_label_class(params[:brand] == brand) %>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

    <button type="submit" name="roll" value="1"
            class="w-full bg-accent hover:bg-accent-hover text-on-accent font-bold py-3 rounded-xl text-lg transition-colors cursor-pointer">
      🎲 Pick for me!
    </button>
  <% end %>

  <%# Result %>
  <% if @picked %>
    <div class="mt-8 bg-panel border border-accent/30 rounded-xl overflow-hidden">
      <img src="<%= kit_image_path(@picked) %>" alt="<%= @picked.title %>" class="w-full bg-elevated">
      <div class="p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 min-w-0 mb-1">
              <h2 class="text-xl font-bold text-ink truncate min-w-0"><%= @picked.title %></h2>
              <%= scalemates_link(@picked) %>
            </div>
            <div class="text-muted text-sm"><%= @picked.subtitle %></div>
            <% if @picked.topic.present? %>
              <div class="text-xs text-dim mt-1"><%= @picked.topic %></div>
            <% end %>
          </div>
          <div class="shrink-0"><%= status_badge(@picked.status) %></div>
        </div>
      </div>
    </div>

  <% elsif params[:roll].present? %>
    <div class="mt-8 text-center py-16 text-muted">
      <div class="text-4xl mb-3">🤷</div>
      <div class="text-lg font-medium text-ink">No owned kits match those filters</div>
      <div class="text-sm mt-1">Try broadening your selection</div>
    </div>
  <% end %>

</div>
