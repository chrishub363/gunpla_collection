<div class="flex gap-4 p-3 <%= index.odd? ? 'bg-surface' : 'bg-panel' %> hover:bg-elevated transition-colors"
     data-filter-target="row"
     data-filter-text="<%= kit.filter_text %>">

  <%# Box art %>
  <div class="shrink-0 w-36 h-24 bg-border rounded overflow-hidden">
    <% if kit.image.present? %>
      <img src="<%= kit_image_path(kit) %>" alt="<%= kit.title %>" class="w-full h-full object-cover">
    <% end %>
  </div>

  <%# Kit info %>
  <div class="flex-1 min-w-0 flex flex-col justify-center">
    <div class="font-medium text-ink flex items-center gap-1.5 min-w-0">
      <span class="truncate min-w-0"><%= kit.title %></span>
      <%= scalemates_link(kit) %>
    </div>
    <div class="text-sm text-muted mt-0.5"><%= kit.subtitle %></div>
    <% if kit.topic.present? %>
      <div class="text-xs text-dim mt-0.5 truncate"><%= kit.topic %></div>
    <% end %>
  </div>

  <%# Status badge %>
  <div class="shrink-0 flex items-center">
    <%= status_badge(kit.status) %>
  </div>

</div>
