<% if params[:page].present? %>
  <%# Subsequent pages — append rows via Turbo Stream %>
  <%= turbo_frame_tag "kits_grid" do %>
    <div data-controller="infinite-scroll">
      <div id="kits_list">
        <%= render "kits_page", kits: @kits, pagy: @pagy %>
      </div>
    </div>
  <% end %>

<% else %>
  <%# Collection / Wishlist tab bar %>
  <%# When searching, neither tab is active — we're showing results across all kits %>
  <nav class="flex items-center border-b border-border mb-6" aria-label="View">
    <%= link_to "Collection", collection_path,
        data: { turbo_action: "advance", turbo_frame: "_top" },
        class: "px-5 py-2.5 text-sm font-semibold border-b-2 -mb-px transition-colors #{!@searching && @tab == 'collection' ? 'border-accent text-ink' : 'border-transparent text-muted hover:text-ink hover:border-muted'}" %>
    <%= link_to "Wishlist", wishlist_path,
        data: { turbo_action: "advance", turbo_frame: "_top" },
        class: "px-5 py-2.5 text-sm font-semibold border-b-2 -mb-px transition-colors #{!@searching && @tab == 'wishlist' ? 'border-accent text-ink' : 'border-transparent text-muted hover:text-ink hover:border-muted'}" %>
  </nav>

  <%# Kit grid with filter + drawer controllers %>
  <div data-controller="filter drawer">

    <%# Backdrop — fullscreen overlay, tapping closes the drawer on mobile %>
    <div data-drawer-target="backdrop"
         data-action="click->drawer#close"
         class="fixed inset-0 bg-black/60 z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    </div>

    <div class="flex gap-6">
      <%= turbo_frame_tag "kits_grid", class: "flex-1 min-w-0" do %>
        <div data-controller="infinite-scroll">
          <% if @kits.any? %>
            <div class="rounded-xl overflow-hidden border border-border" id="kits_list">
              <%= render "kits_page", kits: @kits, pagy: @pagy %>
            </div>
          <% else %>
            <div class="text-center py-24 text-muted">
              <div class="text-4xl mb-4">📦</div>
              <div class="text-lg font-medium">No kits found</div>
              <div class="text-sm mt-1">Try adjusting your filters</div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= render "sidebar" %>
    </div>

    <%# FAB — mobile-only floating button to open the filter drawer %>
    <button type="button"
            data-action="click->drawer#open"
            class="fixed bottom-6 right-6 z-30 md:hidden flex items-center gap-2 bg-accent text-on-accent text-sm font-semibold px-4 py-3 rounded-full shadow-lg active:scale-95 transition-transform">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M3 8h18M3 12h12" />
      </svg>
      Filters
    </button>

  </div>
<% end %>
